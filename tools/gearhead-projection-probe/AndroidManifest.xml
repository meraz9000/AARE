<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.prototux.probe">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="37" />

    <!-- Signature permission, requested only so the probe can report whether it is granted. -->
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:label="Projection probe"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MockProjectionService"
            android:exported="false" />

    </application>
</manifest>
